# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.
# File ini sengaja hanya memuat NAMA variabel, tanpa nilai contoh apa pun.

# --- Supabase -------------------------------------------------------------
# URL project dan anon key boleh terlihat publik (ikut ke bundle browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA. Melewati RLS sepenuhnya. Hanya untuk server (utils/supabase/service.js
# memakai `import 'server-only'` supaya key ini tidak pernah ikut ke browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- Xendit ---------------------------------------------------------------
# RAHASIA. Dari Dashboard Xendit > Settings > Developers > API Keys.
# Mode ditentukan oleh key-nya, bukan oleh URL:
#   * Test  -> key berawalan `xnd_development_` (uang tidak sungguhan)
#   * Live  -> key berawalan `xnd_production_`
# Keduanya memakai host yang sama, https://api.xendit.co.
XENDIT_SECRET_KEY=
# RAHASIA. Harus sama persis dengan "Callback token" di Dashboard Xendit
# (Settings > Webhooks), untuk mode Test dan Live masing-masing.
# Dipakai memverifikasi header `x-callback-token` di webhook invoice.
XENDIT_CALLBACK_TOKEN=
# true = alamat invoice yang dibuat memakai tampilan produksi. Tidak mengubah
# endpoint API; gunakan `false` selama memakai key test.
XENDIT_IS_PRODUCTION=

# --- Midtrans (warisan, tidak dipakai lagi) -------------------------------
# Kode pembayaran sudah pindah ke Xendit. Variabel di bawah hanya dipertahankan
# supaya file .env lama tidak error; aman dikosongkan/dihapus.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=

# --- Telegram -------------------------------------------------------------
# Token bot dari @BotFather.
TELEGRAM_BOT_TOKEN=
# RAHASIA yang Anda tentukan sendiri (mis. 32+ karakter acak). Webhook
# /api/telegram/webhook menolak SEMUA request kalau ini kosong (fail-closed).
# Setelah diisi, daftarkan ulang webhook-nya:
#   curl -X POST "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#     -d "url=https://<domain>/api/telegram/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_WEBHOOK_SECRET=

# --- Aplikasi -------------------------------------------------------------
# Basis URL publik (tanpa garis miring di akhir), dipakai untuk canonical URL,
# OpenGraph, tautan struk Telegram, dan redirect setelah pembayaran Xendit.
# Produksi: https://yandihan.my.id
# Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Opsional, dipertahankan untuk kompatibilitas. Kalau NEXT_PUBLIC_SITE_URL sudah
# diisi, nilai ini tidak dipakai lagi oleh server.
NEXT_PUBLIC_APP_URL=
